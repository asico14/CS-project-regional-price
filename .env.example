# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by git - never commit real secrets.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Channel the worker publishes to: @channel_username or the numeric id
# (-100...). The bot must be an administrator of the channel.
TELEGRAM_CHANNEL_ID=

# How often the worker looks for due posts, in seconds
SCHEDULER_INTERVAL_SECONDS=30

# Optional: the discussion group linked to the channel (numeric id,
# -100...). The bot must be an admin there with "Delete messages" so it
# can switch comments off for posts where the editor unticked "comments".
TELEGRAM_DISCUSSION_GROUP_ID=
