# Copy this file to .env and fill in the values:  cp .env.example .env
# .env is ignored by git - never commit real secrets.

# Django
# Any long random text. Change it before real use.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# 0 for normal use; 1 shows detailed error pages while developing.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Channel the worker publishes to: @channelusername or the numeric id
# (like -1001234567890). The bot must be an administrator of the channel.
TELEGRAM_CHANNEL_ID=

# Optional: the discussion group linked to the channel (numeric id like
# -1009876543210, or @groupusername). Needed to switch comments off for
# single posts. The bot must be an administrator of the group with the
# right to delete messages.
TELEGRAM_DISCUSSION_GROUP_ID=

# How often the worker looks for posts that are due (seconds).
WORKER_POLL_SECONDS=30
