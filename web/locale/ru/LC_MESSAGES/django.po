msgid "Enter prices"
msgstr "Ввод цен"

msgid "Products"
msgstr "Товары"

msgid "Stores"
msgstr "Магазины"

msgid "Baskets"
msgstr "Корзины"

msgid "Posts"
msgstr "Посты"

msgid "Admin"
msgstr "Админ-панель"

msgid "Log out"
msgstr "Выйти"

msgid "Log in"
msgstr "Войти"

msgid "This site is for channel staff only."
msgstr "Этот сайт только для сотрудников канала."

msgid "No access"
msgstr "Нет доступа"

msgid ""
"Your account is not a staff account. Ask an administrator to give you staff "
"access."
msgstr ""
"Ваша учётная запись не является учётной записью сотрудника. Попросите "
"администратора выдать доступ."

msgid "Fergana Valley channel platform"
msgstr "Платформа канала Ферганской долины"

msgid "Manage stores, products and prices for the Telegram channel."
msgstr "Управляйте магазинами, товарами и ценами для Telegram-канала."

#, python-format
msgid "Promotions in %(city)s"
msgstr "Акции в городе %(city)s"

msgid "Promotions in the valley"
msgstr "Акции в долине"

msgid "so'm"
msgstr "сум"

#, python-format
msgid "was %(old)s, −%(percent)s%%"
msgstr "было %(old)s, −%(percent)s%%"

#, python-format
msgid "until %(date)s"
msgstr "до %(date)s"

msgid "Prices can change — check in the store."
msgstr "Цены могут измениться — уточняйте в магазине."

#, python-format
msgid "%(product)s: prices in %(city)s"
msgstr "%(product)s: цены в городе %(city)s"

#, python-format
msgid "%(product)s: prices in the valley"
msgstr "%(product)s: цены в долине"

msgid "promotion"
msgstr "акция"

#, python-format
msgid ""
"Difference between the cheapest and the most expensive: %(difference)s so'm."
msgstr "Разница между самой низкой и самой высокой ценой: %(difference)s сум."

#, python-format
msgid "Prices checked on %(date)s."
msgstr "Цены проверены %(date)s."

#, python-format
msgid "Basket “%(basket)s”: where is it cheaper in %(city)s?"
msgstr "Корзина «%(basket)s»: где дешевле в городе %(city)s?"

#, python-format
msgid "Basket “%(basket)s”: where is it cheaper?"
msgstr "Корзина «%(basket)s»: где дешевле?"

msgid "In the basket:"
msgstr "В корзине:"

#, python-format
msgid ""
"In the cheapest store you save %(saving)s so'm compared with the most "
"expensive one."
msgstr ""
"В самом дешёвом магазине вы экономите %(saving)s сум по сравнению с самым "
"дорогим."

#, python-format
msgid "New store in %(city)s: %(store)s"
msgstr "Новый магазин в городе %(city)s: %(store)s"

#, python-format
msgid "We now follow the prices of %(store)s."
msgstr "Теперь мы следим за ценами в магазине %(store)s."

msgid "Address:"
msgstr "Адрес:"

msgid "Cheapest here in the city:"
msgstr "Здесь дешевле всего в городе:"

msgid "Know a store we should add? Write in the comments."
msgstr "Знаете магазин, который стоит добавить? Напишите в комментариях."

#, python-format
msgid "…and %(counter)s more promotion."
msgid_plural "…and %(counter)s more promotions."
msgstr[0] "…и ещё %(counter)s акция."
msgstr[1] "…и ещё %(counter)s акции."
msgstr[2] "…и ещё %(counter)s акций."

#, python-format
msgid ""
"%(counter)s store is not in the list: it does not have every product of the "
"basket."
msgid_plural ""
"%(counter)s stores are not in the list: they do not have every product of "
"the basket."
msgstr[0] ""
"%(counter)s магазин не вошёл в список: в нём нет всех товаров корзины."
msgstr[1] ""
"%(counter)s магазина не вошли в список: в них нет всех товаров корзины."
msgstr[2] ""
"%(counter)s магазинов не вошли в список: в них нет всех товаров корзины."

#, python-format
msgid "The price of %(counter)s product is already known."
msgid_plural "The prices of %(counter)s products are already known."
msgstr[0] "Уже известна цена %(counter)s товара."
msgstr[1] "Уже известны цены %(counter)s товаров."
msgstr[2] "Уже известны цены %(counter)s товаров."
