#, python-format
msgid "Every store has prices from the last %(stale_days)s days."
msgstr "Har bir do'konda so'nggi %(stale_days)s kunlik narxlar bor."

msgid "Staff access for the channel editors."
msgstr "Kanal muharrirlari uchun kirish."

msgid "Promotion"
msgstr "Aksiya"

